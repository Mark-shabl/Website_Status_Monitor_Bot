# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Monitoring settings
DEFAULT_CHECK_INTERVAL=300
MAX_RETRY_COUNT=3
RETRY_DELAY_SECONDS=5
TIMEOUT_SECONDS=10
USER_AGENT=SiteMonitorBot/1.0
HOST_RATE_LIMIT_SECONDS=30

# History retention
HISTORY_RETENTION_DAYS=3

# Scheduled jobs (timezone-aware)
REPORT_TIMEZONE=Europe/Moscow
REPORT_HOUR=9
REPORT_MINUTE=0
PURGE_HOUR=3
PURGE_MINUTE=0

# Database (local: sqlite:///sites.db, Docker: sqlite+aiosqlite:////app/data/sites.db)
DATABASE_URL=sqlite:///sites.db

# Logging
LOG_LEVEL=INFO
